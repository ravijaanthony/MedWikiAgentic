# Auto-detect: Gemini wins if both keys are set
GEMINI_API_KEY=
GEMINI_REFINE_MODEL=gemini-2.5-flash
GEMINI_AGENT_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_REFINE_MODEL=gpt-4o-mini
OPENAI_AGENT_MODEL=gpt-4o-mini

VALSEA_API_KEY=
VALSEA_BASE_URL=https://api.valsea.ai
VALSEA_MODEL=valsea-transcribe
VALSEA_LANGUAGE=singlish

# Supabase -> Project Settings -> Database -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase -> Project Settings -> API -> Project URL
# Used to fetch JWKS for verifying ES256/RS256 (asymmetric) tokens.
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase -> Project Settings -> API -> JWT Settings -> JWT Secret
# Only required if the project still issues HS256 tokens (legacy mode).
# Leave blank if your project uses asymmetric signing keys (default for new
# projects); JWKS lookup will be used instead.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
