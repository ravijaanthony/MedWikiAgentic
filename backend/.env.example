# Auto-detect: Gemini wins if both keys are set
GEMINI_API_KEY=
GEMINI_REFINE_MODEL=gemini-2.5-flash
GEMINI_AGENT_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_REFINE_MODEL=gpt-4o-mini
OPENAI_AGENT_MODEL=gpt-4o-mini

VALSEA_API_KEY=
VALSEA_BASE_URL=https://api.valsea.ai

# Supabase -> Project Settings -> Database -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
